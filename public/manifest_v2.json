{
  "manifest_version": 2,
  "name": "Privacy Curtain: Blur Gmail™, Chats & Inbox",
  "version": "1.1",
  "description": "Blur your chats and inbox on WhatsApp Web, Gmail, Outlook & Teams so screen-shares and onlookers can't read them. Hover to reveal.",
  "permissions": [
    "storage",
    "https://web.whatsapp.com/*",
    "https://teams.microsoft.com/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://teams.microsoft.com/*",
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "assets/16.png",
    "32": "assets/32.png",
    "48": "assets/48.png",
    "128": "assets/128.png",
    "512": "assets/512.png",
    "1024": "assets/1024.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "assets/16.png",
      "32": "assets/32.png",
      "48": "assets/48.png",
      "128": "assets/128.png"
    },
    "default_title": "Privacy Curtain",
    "default_popup": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-curtain@example.com",
      "strict_min_version": "78.0"
    }
  }
}